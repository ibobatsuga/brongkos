{
  "name": "instadeck-motion-ads-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Instadeck 60s vertical motion ads, rendered with HyperFrames",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "doctor": "hyperframes doctor",
    "c001:sync": "bash scripts/sync_campaign_assets.sh CAMPAIGNS/campaign-001",
    "c001:verify": "python3 scripts/campaign_tool.py verify CAMPAIGNS/campaign-001",
    "c001:build": "python3 scripts/campaign_tool.py build CAMPAIGNS/campaign-001",
    "c001:check": "hyperframes check CAMPAIGNS/campaign-001",
    "c001:preview": "hyperframes preview CAMPAIGNS/campaign-001",
    "c001:draft": "hyperframes render CAMPAIGNS/campaign-001 --fps 30 --quality draft -o RENDERS/previews/campaign-001-draft.mp4",
    "qa": "python3 scripts/qa_video.py"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.152"
  }
}
